{
  "name": "RetailQ API contracts",
  "baseUrl": "http://127.0.0.1:4000/api/",
  "tests": [
    {
      "name": "Health endpoint is ready",
      "path": "health",
      "status": 200,
      "schema": {
        "type": "object",
        "required": ["ok"],
        "properties": { "ok": { "const": true } },
        "additionalProperties": true
      }
    },
    {
      "name": "Tax configuration is a valid basis-point rate",
      "path": "config",
      "status": 200,
      "schema": {
        "type": "object",
        "required": ["tax_bps"],
        "properties": { "tax_bps": { "type": "integer", "minimum": 0, "maximum": 10000 } },
        "additionalProperties": false
      }
    },
    {
      "name": "Product catalog contract and capture product id",
      "path": "products",
      "status": 200,
      "schema": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "name", "category", "price_cents", "inventory", "image_url"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "name": { "type": "string", "minLength": 1 },
            "category": { "type": "string", "minLength": 1 },
            "price_cents": { "type": "integer", "minimum": 0 },
            "inventory": { "type": "integer", "minimum": 0 },
            "image_url": { "type": "string", "pattern": "^https?://" }
          },
          "additionalProperties": true
        }
      },
      "capture": { "productId": "0.id" }
    },
    {
      "name": "Invalid registration payload is rejected",
      "path": "register",
      "method": "POST",
      "body": { "email": "invalid", "password": "short" },
      "status": 400,
      "equals": { "error": "Validation failed" }
    },
    {
      "name": "Unauthenticated cart is rejected",
      "path": "cart",
      "status": 401,
      "equals": { "error": "Unauthorized" }
    },
    {
      "name": "Register isolated contract-test customer",
      "path": "register",
      "method": "POST",
      "body": { "email": "{{email}}", "password": "{{password}}" },
      "status": 201,
      "schema": {
        "type": "object",
        "required": ["id", "email"],
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string", "minLength": 5 }
        }
      }
    },
    {
      "name": "Customer login returns a bearer token",
      "path": "login",
      "method": "POST",
      "body": { "email": "{{email}}", "password": "{{password}}" },
      "status": 200,
      "schema": {
        "type": "object",
        "required": ["token"],
        "properties": { "token": { "type": "string", "minLength": 1 } }
      },
      "capture": { "token": "token" }
    },
    {
      "name": "Saved basket starts empty",
      "path": "cart",
      "headers": { "Authorization": "Bearer {{token}}" },
      "status": 200,
      "schema": {
        "type": "object",
        "required": ["items"],
        "properties": { "items": { "type": "array", "maxItems": 0 } }
      }
    },
    {
      "name": "Persist an item in the customer basket",
      "path": "cart",
      "method": "PUT",
      "headers": { "Authorization": "Bearer {{token}}" },
      "body": { "items": [{ "productId": "{{productId}}", "quantity": 1 }] },
      "status": 200,
      "equals": { "items.0.productId": "{{productId}}", "items.0.quantity": 1 }
    },
    {
      "name": "Persisted basket is readable",
      "path": "cart",
      "headers": { "Authorization": "Bearer {{token}}" },
      "status": 200,
      "equals": { "items.0.productId": "{{productId}}", "items.0.quantity": 1 }
    },
    {
      "name": "Invalid promo is rejected at checkout",
      "path": "orders",
      "method": "POST",
      "headers": { "Authorization": "Bearer {{token}}" },
      "body": {
        "items": [{ "productId": "{{productId}}", "quantity": 1 }],
        "promo": "NOT-A-REAL-PROMO",
        "idempotencyKey": "invalid-{{idempotencyKey}}"
      },
      "status": 400,
      "equals": { "error": "Invalid promo" }
    },
    {
      "name": "Checkout completes with server-calculated integer-cent totals",
      "path": "orders",
      "method": "POST",
      "headers": { "Authorization": "Bearer {{token}}" },
      "body": {
        "items": [{ "productId": "{{productId}}", "quantity": 1 }],
        "promo": "SAVE10",
        "idempotencyKey": "{{idempotencyKey}}"
      },
      "status": 201,
      "schema": {
        "type": "object",
        "required": ["id", "subtotal_cents", "discount_cents", "tax_cents", "total_cents"],
        "properties": {
          "id": { "type": "integer" },
          "subtotal_cents": { "type": "integer", "minimum": 0 },
          "discount_cents": { "type": "integer", "minimum": 0 },
          "tax_cents": { "type": "integer", "minimum": 0 },
          "total_cents": { "type": "integer", "minimum": 0 }
        }
      },
      "capture": { "orderId": "id" }
    },
    {
      "name": "Duplicate checkout key replays the original order",
      "path": "orders",
      "method": "POST",
      "headers": { "Authorization": "Bearer {{token}}" },
      "body": {
        "items": [{ "productId": "{{productId}}", "quantity": 1 }],
        "promo": "SAVE10",
        "idempotencyKey": "{{idempotencyKey}}"
      },
      "status": 200,
      "equals": { "id": "{{orderId}}", "replayed": true }
    },
    {
      "name": "Order history contains the completed checkout",
      "path": "orders",
      "headers": { "Authorization": "Bearer {{token}}" },
      "status": 200,
      "schema": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "total_cents"],
          "properties": {
            "id": { "type": "integer" },
            "total_cents": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "equals": { "0.id": "{{orderId}}" }
    }
  ]
}
